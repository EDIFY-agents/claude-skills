# Default: everything is reviewed by the maintainers.
*                               @EDIFY-agents/maintainers

# Contracts. Changing one of these invalidates specs that already exist in other
# people's repositories, so they carry a heavier review than the code that reads them.
/edify/formats/                 @EDIFY-agents/maintainers
/edify/commands/                @EDIFY-agents/maintainers
/src/edify/formats/             @EDIFY-agents/maintainers

# Curated library entries — merged after screening, never on sight.
/edify/skills/                  @EDIFY-agents/maintainers

# Licence, gates, and anything that decides what costs money.
/src/edify/licensing/           @EDIFY-agents/maintainers

# Legal surface. No exceptions and no delegated review.
/LICENSE                        @EDIFY-agents/maintainers
/NOTICE                         @EDIFY-agents/maintainers
/TRADEMARK.md                   @EDIFY-agents/maintainers
/GOVERNANCE.md                  @EDIFY-agents/maintainers
/SECURITY.md                    @EDIFY-agents/maintainers
/CONTRIBUTING.md                @EDIFY-agents/maintainers

# Supply chain and the guard that keeps private material out of this repository.
/.github/workflows/             @EDIFY-agents/maintainers
/pyproject.toml                 @EDIFY-agents/maintainers
